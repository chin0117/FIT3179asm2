{
  "description": "Context: all-purpose domestic day trips by destination state, June quarter 2026, from TRA DoTS. Not nature-specific.",
  "title": "Domestic day trips by state · 2026",
  "width": 640,
  "height": 390,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -28
    ],
    "scale": 540
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.STATE_NAME",
      "as": "state_name"
    },
    {
      "calculate": "datum.state_name === 'New South Wales' ? 'NSW' : datum.state_name === 'Victoria' ? 'VIC' : datum.state_name === 'Queensland' ? 'QLD' : datum.state_name === 'South Australia' ? 'SA' : datum.state_name === 'Western Australia' ? 'WA' : datum.state_name === 'Tasmania' ? 'TAS' : datum.state_name === 'Northern Territory' ? 'NT' : datum.state_name === 'Australian Capital Territory' ? 'ACT' : datum.state_name",
      "as": "state"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/day_trips_quarterly.csv"
        },
        "key": "state",
        "fields": [
          "q2_2026"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "q2_2026",
      "type": "quantitative",
      "title": "Day trips (thousands)",
      "scale": {
        "scheme": "tealblues"
      },
      "legend": {
        "orient": "right",
        "direction": "vertical",
        "gradientLength": 130,
        "titleLimit": 120,
        "offset": 7,
        "labelLimit": 110,
        "labelFontSize": 13,
        "titleFontSize": 14,
        "gradientThickness": 12,
        "fillColor": "#F7FBF9",
        "strokeColor": "#C7D9D0",
        "cornerRadius": 7,
        "padding": 9,
        "labelColor": "#233F38",
        "titleColor": "#234D41"
      }
    },
    "tooltip": [
      {
        "field": "state_name",
        "type": "nominal",
        "title": "Destination state"
      },
      {
        "field": "q2_2026",
        "type": "quantitative",
        "title": "Day trips ('000)",
        "format": ",.0f"
      }
    ],
    "opacity": {
      "condition": {
        "param": "selectedState",
        "value": 1
      },
      "value": 0.3
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Calibri, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#ecf2f0",
      "domainColor": "#bac9c5",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelFont": "Calibri, Arial, sans-serif",
      "titleFont": "Calibri, Arial, sans-serif"
    },
    "legend": {
      "labelColor": "#233F38",
      "titleColor": "#234D41",
      "fillColor": "#F7FBF9",
      "strokeColor": "#C7D9D0",
      "cornerRadius": 7,
      "padding": 9,
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 19,
      "fontWeight": "normal",
      "anchor": "middle"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelFont": "Calibri, Arial, sans-serif"
    }
  },
  "params": [
    {
      "name": "selectedState",
      "select": {
        "type": "point",
        "fields": [
          "state"
        ],
        "on": "click",
        "clear": "dblclick"
      }
    }
  ]
}
