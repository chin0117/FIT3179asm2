{
  "description": "Context: all-purpose domestic day trips by destination state, June quarter 2026, from TRA DoTS. Not nature-specific.",
  "title": "Domestic day trips by destination state \u00b7 absolute counts",
  "width": 640,
  "height": 390,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -28
    ],
    "scale": 540
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.STATE_NAME",
      "as": "state_name"
    },
    {
      "calculate": "datum.state_name === 'New South Wales' ? 'NSW' : datum.state_name === 'Victoria' ? 'VIC' : datum.state_name === 'Queensland' ? 'QLD' : datum.state_name === 'South Australia' ? 'SA' : datum.state_name === 'Western Australia' ? 'WA' : datum.state_name === 'Tasmania' ? 'TAS' : datum.state_name === 'Northern Territory' ? 'NT' : datum.state_name === 'Australian Capital Territory' ? 'ACT' : datum.state_name",
      "as": "state"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/day_trips_quarterly.csv"
        },
        "key": "state",
        "fields": [
          "q2_2026"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "q2_2026",
      "type": "quantitative",
      "title": "Day trips (thousands)",
      "scale": {
        "scheme": "tealblues"
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 220,
        "titleLimit": 180
      }
    },
    "tooltip": [
      {
        "field": "state_name",
        "type": "nominal",
        "title": "Destination state"
      },
      {
        "field": "q2_2026",
        "type": "quantitative",
        "title": "Day trips ('000)",
        "format": ",.0f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#ecf2f0",
      "domainColor": "#bac9c5"
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#334155"
    }
  }
}