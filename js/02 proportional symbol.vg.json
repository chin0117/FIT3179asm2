{
  "description": "NSW NPWS Park Visitation Survey, financial year 2024-25. Figures are total park VISITS (repeat visits possible).",
  "title": "NSW park visits · 2024-25",
  "width": 650,
  "height": 410,
  "projection": {
    "type": "mercator",
    "center": [
      149.7,
      -34.55
    ],
    "scale": 2900
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STATE_NAME === 'New South Wales'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e8f3ed",
        "stroke": "#8aa99d",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/nsw_parks.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.67,
        "stroke": "white",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "visitors",
          "type": "quantitative",
          "title": "Park visits (millions)",
          "scale": {
            "type": "sqrt",
            "range": [
              130,
              3200
            ]
          },
          "legend": null
        },
        "color": {
          "field": "visitors",
          "type": "quantitative",
          "title": "Park visits (millions)",
          "scale": {
            "scheme": "goldgreen"
          },
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "title": "Park visits (millions)",
            "offset": 7,
            "titleLimit": 120,
            "labelLimit": 110,
            "labelFontSize": 13,
            "titleFontSize": 14,
            "gradientLength": 130,
            "gradientThickness": 12,
            "fillColor": "#F7FBF9",
            "strokeColor": "#C7D9D0",
            "cornerRadius": 7,
            "padding": 9,
            "labelColor": "#233F38",
            "titleColor": "#234D41"
          }
        },
        "tooltip": [
          {
            "field": "park",
            "type": "nominal",
            "title": "Park / protected area"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Visits (millions)",
            "format": ".1f"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.visitors >= minimumParkVisits"
        }
      ]
    },
    {
      "data": {
        "url": "data/nsw_parks.csv"
      },
      "transform": [
        {
          "filter": "datum.visitors >= minimumParkVisits"
        },
        {
          "filter": "datum.park === 'Blue Mountains NP'"
        },
        {
          "calculate": "'Blue Mountains: ' + format(datum.visitors, '.1f') + 'm visits'",
          "as": "callout"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 22,
        "dy": -24,
        "fontSize": 10,
        "fontWeight": "bold",
        "align": "left",
        "color": "#22584b"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "callout",
          "type": "nominal"
        }
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Calibri, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#ecf2f0",
      "domainColor": "#bac9c5",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelFont": "Calibri, Arial, sans-serif",
      "titleFont": "Calibri, Arial, sans-serif"
    },
    "legend": {
      "labelColor": "#233F38",
      "titleColor": "#234D41",
      "fillColor": "#F7FBF9",
      "strokeColor": "#C7D9D0",
      "cornerRadius": 7,
      "padding": 9,
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 19,
      "fontWeight": "normal",
      "anchor": "middle"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelFont": "Calibri, Arial, sans-serif"
    }
  },
  "params": [
    {
      "name": "minimumParkVisits",
      "value": 1.5,
      "bind": {
        "input": "range",
        "min": 1.5,
        "max": 7.5,
        "step": 0.5,
        "name": "Park visits >= (million): "
      }
    }
  ]
}
