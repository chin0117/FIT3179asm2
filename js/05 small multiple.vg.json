{
  "description": "All-purpose domestic overnight trips, five quarters (Jun 2025-Jun 2026), DoTS. Small multiples count as ONE idiom.",
  "title": "Quarterly overnight trips by state · June 2025-June 2026",
  "data": {
    "url": "data/overnight_trips_quarterly.csv"
  },
  "transform": [
    {
      "calculate": "datum.quarter === 'Jun 25' ? 1 : datum.quarter === 'Sep 25' ? 2 : datum.quarter === 'Dec 25' ? 3 : datum.quarter === 'Mar 26' ? 4 : 5",
      "as": "quarter_order"
    }
  ],
  "facet": {
    "field": "state",
    "type": "nominal",
    "title": null,
    "sort": [
      "NSW",
      "VIC",
      "QLD",
      "WA",
      "SA",
      "TAS",
      "NT",
      "ACT"
    ]
  },
  "spec": {
    "width": 118,
    "height": 92,
    "mark": {
      "type": "line",
      "point": {
        "filled": true,
        "size": 28
      },
      "color": "#287e71",
      "strokeWidth": 2.1
    },
    "encoding": {
      "x": {
        "field": "quarter",
        "type": "ordinal",
        "sort": [
          "Jun 25",
          "Sep 25",
          "Dec 25",
          "Mar 26",
          "Jun 26"
        ],
        "title": null,
        "axis": {
          "labelAngle": -35,
          "labelFontSize": 9
        }
      },
      "y": {
        "field": "trips",
        "type": "quantitative",
        "title": "Overnight trips ('000)",
        "scale": {
          "zero": false
        },
        "axis": {
          "title": null,
          "labelFontSize": 9
        }
      },
      "tooltip": [
        {
          "field": "state",
          "type": "nominal"
        },
        {
          "field": "quarter",
          "type": "nominal"
        },
        {
          "field": "trips",
          "type": "quantitative",
          "title": "Trips ('000)",
          "format": ",.0f"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Calibri, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#ecf2f0",
      "domainColor": "#bac9c5"
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#334155"
    },
    "facet": {
      "spacing": 10
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 15,
      "fontWeight": "bold"
    }
  },
  "columns": 4
}
