{
  "description": "Nature visitor segments in 2008 and 2015, based on 2016 State of the Environment series.",
  "width": 440,
  "height": 300,
  "data": {
    "url": "data/nature_endpoints.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "sort": [
            "2008",
            "2015"
          ],
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 13,
            "titleFontSize": 14
          }
        },
        "y": {
          "field": "visitors_m",
          "type": "quantitative",
          "title": "Nature visitors (millions)",
          "scale": {
            "zero": true
          }
        },
        "detail": {
          "field": "type",
          "type": "nominal"
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Domestic day",
              "Domestic overnight",
              "International"
            ],
            "range": [
              "#16876A",
              "#6558BB",
              "#C05697"
            ]
          },
          "title": "Segment",
          "legend": null
        },
        "tooltip": [
          {
            "field": "type",
            "type": "nominal",
            "title": "Visitor segment"
          },
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "visitors_m",
            "type": "quantitative",
            "title": "Millions",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2008",
            "2015"
          ]
        },
        "y": {
          "field": "visitors_m",
          "type": "quantitative"
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Domestic day",
              "Domestic overnight",
              "International"
            ],
            "range": [
              "#16876A",
              "#6558BB",
              "#C05697"
            ]
          }
        },
        "tooltip": [
          {
            "field": "type",
            "type": "nominal"
          },
          {
            "field": "year",
            "type": "nominal"
          },
          {
            "field": "visitors_m",
            "type": "quantitative",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2015'"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 12,
        "align": "left",
        "fontWeight": 700,
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2008",
            "2015"
          ]
        },
        "y": {
          "field": "visitors_m",
          "type": "quantitative"
        },
        "text": {
          "field": "type",
          "type": "nominal"
        }
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Calibri, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#ecf2f0",
      "domainColor": "#bac9c5",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelFont": "Calibri, Arial, sans-serif",
      "titleFont": "Calibri, Arial, sans-serif"
    },
    "legend": {
      "labelColor": "#233F38",
      "titleColor": "#234D41",
      "fillColor": "#F7FBF9",
      "strokeColor": "#C7D9D0",
      "cornerRadius": 7,
      "padding": 9,
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 19,
      "fontWeight": "normal",
      "anchor": "middle"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelFont": "Calibri, Arial, sans-serif"
    }
  }
}
