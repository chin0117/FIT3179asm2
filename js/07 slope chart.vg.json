{
  "description": "Nature visitor segments in 2008 and 2015. End labels show increases in millions, calculated from the dataset; legend identifies the visitor categories.",
  "width": 440,
  "height": 300,
  "data": {
    "url": "data/nature_endpoints.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "sort": [
            "2008",
            "2015"
          ],
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 13,
            "titleFontSize": 14
          }
        },
        "y": {
          "field": "visitors_m",
          "type": "quantitative",
          "title": "Nature visitors (millions)",
          "scale": {
            "zero": true
          }
        },
        "detail": {
          "field": "type",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "type",
            "type": "nominal",
            "title": "Visitor segment"
          },
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "visitors_m",
            "type": "quantitative",
            "title": "Millions",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2008",
            "2015"
          ]
        },
        "y": {
          "field": "visitors_m",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "type",
            "type": "nominal"
          },
          {
            "field": "year",
            "type": "nominal"
          },
          {
            "field": "visitors_m",
            "type": "quantitative",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "visitors_m",
              "as": "segment_min"
            },
            {
              "op": "max",
              "field": "visitors_m",
              "as": "segment_max"
            }
          ],
          "groupby": [
            "type"
          ]
        },
        {
          "filter": "datum.year == 2015"
        },
        {
          "calculate": "'+' + format(datum.segment_max - datum.segment_min, '.2f') + 'm'",
          "as": "visitor_increase"
        },
        {
          "calculate": "datum.visitors_m + (datum.type === 'Domestic day' ? 0.45 : datum.type === 'Domestic overnight' ? -0.60 : 0)",
          "as": "annotation_y"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 10,
        "align": "left",
        "fontWeight": "bold",
        "fontSize": 13
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2008",
            "2015"
          ]
        },
        "y": {
          "field": "annotation_y",
          "type": "quantitative"
        },
        "text": {
          "field": "visitor_increase",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "type",
            "type": "nominal",
            "title": "Visitor group"
          },
          {
            "field": "visitor_increase",
            "type": "nominal",
            "title": "Increase, 2008-2015"
          },
          {
            "field": "visitors_m",
            "type": "quantitative",
            "title": "2015 visitors (millions)",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Calibri, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#ecf2f0",
      "domainColor": "#bac9c5",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelFont": "Calibri, Arial, sans-serif",
      "titleFont": "Calibri, Arial, sans-serif"
    },
    "legend": {
      "labelColor": "#233F38",
      "titleColor": "#234D41",
      "fillColor": "#F7FBF9",
      "strokeColor": "#C7D9D0",
      "cornerRadius": 7,
      "padding": 9,
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 19,
      "fontWeight": "normal",
      "anchor": "middle"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelFont": "Calibri, Arial, sans-serif"
    }
  },
  "encoding": {
    "color": {
      "field": "type",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Domestic day",
          "Domestic overnight",
          "International"
        ],
        "range": [
          "#16876A",
          "#6558BB",
          "#C05697"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "title": null,
        "labelFontSize": 13,
        "symbolSize": 110,
        "columns": 3,
        "fillColor": "#F7FBF9",
        "strokeColor": "#C7D9D0",
        "cornerRadius": 9,
        "padding": 10,
        "offset": 10,
        "labelColor": "#233F38",
        "labelLimit": 160
      }
    }
  }
}
