{
  "description": "The combined reported segment counts are NOT unique individuals; waterfall shows additive change in the three reported nature visitor categories, 2008 to 2015.",
  "width": 600,
  "height": 305,
  "data": {
    "url": "data/waterfall_nature.csv"
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Calibri, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#ecf2f0",
      "domainColor": "#bac9c5",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelFont": "Calibri, Arial, sans-serif",
      "titleFont": "Calibri, Arial, sans-serif"
    },
    "legend": {
      "labelColor": "#233F38",
      "titleColor": "#234D41",
      "fillColor": "#F7FBF9",
      "strokeColor": "#C7D9D0",
      "cornerRadius": 7,
      "padding": 9,
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 19,
      "fontWeight": "normal",
      "anchor": "middle"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelFont": "Calibri, Arial, sans-serif"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 58,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": [
            "2008 total",
            "Domestic day",
            "Domestic overnight",
            "International",
            "2015 total"
          ],
          "title": null,
          "axis": {
            "labelAngle": -20,
            "labelFontSize": 13,
            "titleFontSize": 14
          }
        },
        "y": {
          "field": "start",
          "type": "quantitative",
          "title": "Sum of visitor segment counts (millions)",
          "scale": {
            "zero": true
          }
        },
        "y2": {
          "field": "end"
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "title": "Bar meaning",
            "symbolType": "square",
            "labelLimit": 110,
            "offset": 7,
            "titleLimit": 120,
            "labelFontSize": 13,
            "titleFontSize": 14,
            "symbolSize": 90,
            "fillColor": "#F7FBF9",
            "strokeColor": "#C7D9D0",
            "cornerRadius": 7,
            "padding": 9,
            "labelColor": "#233F38",
            "titleColor": "#234D41"
          },
          "scale": {
            "domain": [
              "total",
              "increase",
              "decrease"
            ],
            "range": [
              "#52647C",
              "#329574",
              "#D05A70"
            ]
          },
          "title": "Bar meaning"
        },
        "tooltip": [
          {
            "field": "step",
            "type": "nominal",
            "title": "Contribution"
          },
          {
            "field": "delta",
            "type": "quantitative",
            "title": "Value / change (m)",
            "format": "+.2f"
          },
          {
            "field": "end",
            "type": "quantitative",
            "title": "Cumulative (m)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind === 'increase'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#255d51"
      },
      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": [
            "2008 total",
            "Domestic day",
            "Domestic overnight",
            "International",
            "2015 total"
          ]
        },
        "y": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "delta",
          "type": "quantitative",
          "format": "+.2f"
        }
      }
    }
  ]
}
