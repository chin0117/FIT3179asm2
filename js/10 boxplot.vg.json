{
  "description": "Five observations per state, Jun 2025 through Jun 2026. Annual seasonality cannot be inferred from just five quarterly data points.",
  "title": "Average nights per overnight trip \u00b7 June 2025-June 2026",
  "width": 450,
  "height": 300,
  "data": {
    "url": "data/trip_length.csv"
  },
  "mark": {
    "type": "boxplot",
    "extent": "min-max",
    "size": 28,
    "median": {
      "color": "#12343b",
      "strokeWidth": 2
    },
    "rule": {
      "color": "#12343b",
      "strokeWidth": 1.8
    },
    "ticks": {
      "color": "#12343b",
      "strokeWidth": 1.8
    },
    "box": {
      "fill": "#80b7c2",
      "stroke": "#12343b",
      "strokeWidth": 1.2
    }
  },
  "encoding": {
    "x": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": [
        "NSW",
        "VIC",
        "QLD",
        "WA",
        "SA",
        "TAS",
        "NT",
        "ACT"
      ]
    },
    "y": {
      "field": "average_nights",
      "type": "quantitative",
      "title": "Average nights per overnight trip",
      "scale": {
        "zero": false
      }
    },
    "color": {
      "field": "state",
      "type": "nominal",
      "legend": {
        "orient": "bottom",
        "direction": "horizontal"
      },
      "scale": {
        "scheme": "tealblues"
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal"
      },
      {
        "field": "average_nights",
        "type": "quantitative",
        "title": "Average nights / trip",
        "format": ".2f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Calibri, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#ecf2f0",
      "domainColor": "#bac9c5"
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#334155"
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 15,
      "fontWeight": "bold"
    }
  }
}