{
  "description": "Five observations per state, Jun 2025 through Jun 2026. Annual seasonality cannot be inferred from just five quarterly data points.",
  "title": "Which states have the most variable average overnight-trip length?",
  "width": 700,
  "height": 335,
  "data": {
    "url": "data/trip_length.csv"
  },
  "mark": {
    "type": "boxplot",
