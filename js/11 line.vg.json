{
  "description": "Lorenz curve computed only over the 10 highest-visit NSW parks, FY2024-25; curve cannot be generalized to all NSW parks.",
  "width": 440,
  "height": 300,
  "layer": [
    {
      "data": {
        "url": "data/park_concentration.csv"
      },
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 43
        },
        "color": "#24628A"
      },
      "encoding": {
        "x": {
          "field": "park_share",
          "type": "quantitative",
          "title": "Share of parks included (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y": {
          "field": "visits_share",
          "type": "quantitative",
          "title": "Cumulative share of their visits (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "tooltip": [
          {
            "field": "park",
            "type": "nominal",
            "title": "Last park included"
          },
          {
            "field": "park_share",
            "type": "quantitative",
            "title": "% parks",
            "format": ".0f"
          },
          {
            "field": "visits_share",
            "type": "quantitative",
            "title": "Cumulative visit share",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "s": 0
          },
          {
            "s": 100
          }
        ]
      },
      "mark": {
        "type": "line",
        "strokeDash": [
          6,
          5
        ],
        "color": "#b1aca6",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "s",
          "type": "quantitative"
        },
        "y": {
          "field": "s",
          "type": "quantitative"
        }
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Calibri, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#ecf2f0",
      "domainColor": "#bac9c5",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelFont": "Calibri, Arial, sans-serif",
      "titleFont": "Calibri, Arial, sans-serif"
    },
    "legend": {
      "labelColor": "#233F38",
      "titleColor": "#234D41",
      "fillColor": "#F7FBF9",
      "strokeColor": "#C7D9D0",
      "cornerRadius": 7,
      "padding": 9,
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 19,
      "fontWeight": "normal",
      "anchor": "middle"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelFont": "Calibri, Arial, sans-serif"
    }
  }
}
