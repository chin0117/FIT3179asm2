{
  "description": "All-purpose domestic overnight trips, June quarter 2025 vs June quarter 2026. Holiday travel does not equate to nature-based tourism.",
  "title": "Overnight trips by purpose · 2025-2026",
  "width": 450,
  "height": 300,
  "data": {
    "url": "data/reason_of_visit.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "reason",
      "type": "nominal",
      "title": "Main reason for trip",
      "sort": [
        "Holiday",
        "VFR",
        "Business",
        "Other"
      ],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13,
        "titleFontSize": 14
      }
    },
    "xOffset": {
      "field": "quarter",
      "type": "nominal"
    },
    "y": {
      "field": "trips",
      "type": "quantitative",
      "title": "Overnight trips ('000)"
    },
    "color": {
      "field": "quarter",
      "type": "nominal",
      "title": "Quarter",
      "scale": {
        "domain": [
          "Q2 2025",
          "Q2 2026"
        ],
        "range": [
          "#2f7f95",
          "#d08c3f"
        ]
      },
      "legend": {
        "orient": "right",
        "direction": "vertical",
        "offset": 7,
        "titleLimit": 120,
        "labelLimit": 110,
        "labelFontSize": 13,
        "titleFontSize": 14,
        "symbolSize": 90,
        "fillColor": "#F7FBF9",
        "strokeColor": "#C7D9D0",
        "cornerRadius": 7,
        "padding": 9,
        "labelColor": "#233F38",
        "titleColor": "#234D41"
      }
    },
    "tooltip": [
      {
        "field": "reason",
        "type": "nominal"
      },
      {
        "field": "quarter",
        "type": "nominal"
      },
      {
        "field": "trips",
        "type": "quantitative",
        "title": "Trips ('000)",
        "format": ",.0f"
      }
    ],
    "opacity": {
      "condition": {
        "param": "selectedQuarter",
        "value": 1
      },
      "value": 0.22
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Calibri, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#ecf2f0",
      "domainColor": "#bac9c5",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelFont": "Calibri, Arial, sans-serif",
      "titleFont": "Calibri, Arial, sans-serif"
    },
    "legend": {
      "labelColor": "#233F38",
      "titleColor": "#234D41",
      "fillColor": "#F7FBF9",
      "strokeColor": "#C7D9D0",
      "cornerRadius": 7,
      "padding": 9,
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 19,
      "fontWeight": "normal",
      "anchor": "middle"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelFont": "Calibri, Arial, sans-serif"
    }
  },
  "params": [
    {
      "name": "selectedQuarter",
      "select": {
        "type": "point",
        "fields": [
          "quarter"
        ]
      },
      "bind": "legend"
    }
  ]
}
