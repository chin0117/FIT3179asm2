{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Advanced Pareto combination chart. Top-ten NSW park visits in FY2024-25, cumulative share derived solely from included park counts.",
  "width": 900,
  "height": 230,
  "data": {
    "url": "data/nsw_park_pareto.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#73589F",
        "cornerRadiusTopLeft": 2,
        "cornerRadiusTopRight": 2
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "nominal",
          "title": null,
          "sort": [
            "Blue Mountains",
            "Royal",
            "Ku-ring-gai",
            "Lane Cove",
            "Kosciuszko",
            "Sydney Harbour",
            "Brisbane Water",
            "Morton",
            "Bouddi",
            "Glenrock"
          ],
          "axis": {
            "labelAngle": -30,
            "labelLimit": 130,
            "labelFontSize": 13,
            "titleFontSize": 14
          }
        },
        "y": {
          "field": "visits_m",
          "type": "quantitative",
          "title": "Park visit volume (million)",
          "scale": {
            "zero": true
          },
          "axis": {
            "titleColor": "#73589F",
            "labelFontSize": 13,
            "titleFontSize": 14
          }
        },
        "tooltip": [
          {
            "field": "park",
            "type": "nominal",
            "title": "Park"
          },
          {
            "field": "visits_m",
            "type": "quantitative",
            "title": "Visits (million)",
            "format": ".1f"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of the ten (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#C15F79",
        "point": {
          "filled": true,
          "size": 68
        },
        "strokeWidth": 2.7
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "nominal",
          "sort": [
            "Blue Mountains",
            "Royal",
            "Ku-ring-gai",
            "Lane Cove",
            "Kosciuszko",
            "Sydney Harbour",
            "Brisbane Water",
            "Morton",
            "Bouddi",
            "Glenrock"
          ]
        },
        "y": {
          "field": "cumulative_pct",
          "type": "quantitative",
          "title": "Cumulative visit share (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "orient": "right",
            "titleColor": "#C15F79",
            "labelFontSize": 13,
            "titleFontSize": 14
          }
        },
        "tooltip": [
          {
            "field": "park",
            "type": "nominal",
            "title": "Park"
          },
          {
            "field": "cumulative_pct",
            "type": "quantitative",
            "title": "Cumulative share",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "config": {
    "font": "Calibri, Arial, sans-serif",
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 19,
      "fontWeight": "normal",
      "anchor": "middle"
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 14,
      "gridColor": "#edf2ee",
      "labelFont": "Calibri, Arial, sans-serif",
      "titleFont": "Calibri, Arial, sans-serif"
    },
    "view": {
      "stroke": null
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelFont": "Calibri, Arial, sans-serif"
    },
    "legend": {
      "fillColor": "#F7FBF9",
      "strokeColor": "#C7D9D0",
      "cornerRadius": 7,
      "padding": 9,
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelColor": "#233F38",
      "titleColor": "#234D41"
    }
  },
  "params": [
    {
      "name": "topParks",
      "value": 10,
      "bind": {
        "input": "range",
        "min": 3,
        "max": 10,
        "step": 1,
        "name": "Show top parks: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.rank <= topParks"
    }
  ]
}
