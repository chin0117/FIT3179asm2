{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Advanced Pareto combination chart. Top-ten NSW park visits in FY2024-25, cumulative share derived solely from included park counts.",
  "title": "The leading three parks account for 54.7% of these visits",
  "width": 900,
  "height": 285,
  "data": {
    "url": "data/nsw_park_pareto.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#66a89d",
        "cornerRadiusTopLeft": 2,
        "cornerRadiusTopRight": 2
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "nominal",
          "title": null,
          "sort": [
            "Blue Mountains",
            "Royal",
            "Ku-ring-gai",
            "Lane Cove",
            "Kosciuszko",
            "Sydney Harbour",
            "Brisbane Water",
            "Morton",
            "Bouddi",
            "Glenrock"
          ],
          "axis": {
            "labelAngle": -30,
            "labelLimit": 130
          }
        },
        "y": {
          "field": "visits_m",
          "type": "quantitative",
          "title": "Park visits (millions)",
          "scale": {
            "zero": true
          },
          "axis": {
            "titleColor": "#28695e"
          }
        },
        "tooltip": [
          {
            "field": "park",
            "type": "nominal",
            "title": "Park"
          },
          {
            "field": "visits_m",
            "type": "quantitative",
            "title": "Visits (million)",
            "format": ".1f"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of the ten (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#b26735",
        "point": {
          "filled": true,
          "size": 68
        },
        "strokeWidth": 2.7
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "nominal",
          "sort": [
            "Blue Mountains",
            "Royal",
            "Ku-ring-gai",
            "Lane Cove",
            "Kosciuszko",
            "Sydney Harbour",
            "Brisbane Water",
            "Morton",
            "Bouddi",
            "Glenrock"
          ]
        },
        "y": {
          "field": "cumulative_pct",
          "type": "quantitative",
          "title": "Cumulative share (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "orient": "right",
            "titleColor": "#b26735"
          }
        },
        "tooltip": [
          {
            "field": "park",
            "type": "nominal",
            "title": "Park"
          },
          {
            "field": "cumulative_pct",
            "type": "quantitative",
            "title": "Cumulative share",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "config": {
    "font": "Calibri, Arial, sans-serif",
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 15,
      "fontWeight": "bold"
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#edf2ee"
    },
    "view": {
      "stroke": null
    }
  }
}
